# App
APP_NAME=Pilot My Career AI Backend
APP_ENV=local
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Auth: dev | supabase
AUTH_MODE=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Persistence (set to true once ai_reports / ai_usage_logs tables exist)
SUPABASE_PERSIST=false

# Optional infra
DATABASE_URL=
REDIS_URL=

# Vector store: local | qdrant
VECTOR_PROVIDER=local
QDRANT_URL=
QDRANT_API_KEY=
